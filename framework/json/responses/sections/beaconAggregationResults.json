{
    "$defs": {
        "AggregationConcept": {
            "description": "Concept on which the aggregation was performed, including the scoped property, and optional terms or splits for selection or binning of the property values.",
            "properties": {
                "description": {
                    "description": "A description of the summary concept, e.g. with details about the included property and the operations performed during aggregation."
                },
                "id": {
                    "description": "The aggregation term id. It can be used to limit or combine the aggregations performed.",
                    "examples": [
                        "followupTime",
                        "sexAtBirth"
                    ],
                    "type": "string"
                },
                "label": {
                    "description": "A short label which e.g. can be used by clients to label diagrams or data tables.",
                    "examples": [
                        "Follow-up Time After Diagnosis"
                    ],
                    "type": "string"
                },
                "property": {
                    "description": "The property, including the entity/scope, in the data model on which the aggregation was performed.",
                    "examples": [
                        "biosample.histologicalDiagnosis.id",
                        "individual.sex.id",
                        "biosample.collectionMoment"
                    ],
                    "type": "string"
                },
                "sorted": {
                    "description": "Indicates whether the resulting distribution results will be sorted in some way.",
                    "type": "boolean"
                },
                "splits": {
                    "description": "Optional list of **sorted** splits to group values for ranges or bins when performing the aggregation. TODO: \n  * Define types and/or couple them to property type\n  * value/label object definition",
                    "examples": [
                        [
                            {
                                "label": "< 18 months",
                                "value": "P18M"
                            },
                            {
                                "label": "1.5 to < 18 years",
                                "value": "P18Y"
                            },
                            {
                                "label": "18 to < 65 years",
                                "value": "P65Y"
                            },
                            {
                                "label": "65 to < 80 years",
                                "value": "P80Y"
                            },
                            {
                                "label": "80 years and older",
                                "value": "P150Y"
                            }
                        ]
                    ],
                    "items": {
                        "type": "object"
                    },
                    "type": "array"
                },
                "terms": {
                    "description": "Optional list of terms to select specific values for aggregation. TODO: \n  * id/label object definition",
                    "examples": [
                        [
                            {
                                "id": "NCIT:C9384",
                                "label": "Kidney Carcinoma"
                            },
                            {
                                "id": "NCIT:C3513",
                                "label": "Esophageal Carcinoma"
                            },
                            {
                                "id": "NCIT:C35850",
                                "label": "Head and Neck Carcinoma"
                            },
                            {
                                "id": "NCIT:C4878",
                                "label": "Lung Carcinoma"
                            },
                            {
                                "id": "NCIT:C207229"
                            }
                        ],
                        [
                            {
                                "id": "EFO:0030075",
                                "label": "cDNA microarray"
                            },
                            {
                                "id": "EFO:0010938",
                                "label": "large-insert clone DNA microarray"
                            },
                            {
                                "id": "EFO:0010939",
                                "label": "oligonucleotide DNA microarray"
                            },
                            {
                                "id": "EFO:0010937",
                                "label": "comparative genomic hybridization (CGH)"
                            }
                        ]
                    ],
                    "items": {
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "required": [
                "id"
            ],
            "type": "object"
        },
        "AggregationObject": {
            "additionalItems": true,
            "description": "Aggregation object describing the count of one (or more, intersected) values for the concept(s) aggregated on.",
            "properties": {
                "conceptValues": {
                    "description": "List of ordered concept values (one per concept in `concepts`). These can represent values from the respected property or interpolations ( e.g. bins from splits).",
                    "items": {
                        "$ref": "#/$defs/ConceptValue"
                    },
                    "type": "array"
                },
                "count": {
                    "description": "Count of occurrences for this aggregation object in the matched data.",
                    "minimum": 0,
                    "type": "integer"
                }
            },
            "required": [
                "conceptValues",
                "count"
            ],
            "type": "object"
        },
        "AggregationResultsInstance": {
            "additionalItems": true,
            "description": "Summary data from results, with distributions of values (or value combinations) for one (or more) concepts. Each summary is identified by an `id`, `label`, `description`, and a list of one or more `concepts`. An an optional `sorted` property can indicate to the client that the returned `distribution` of the aggregation objects response has some pre-defined order. Each of the `concepts` describes the scope (entity; `individual`, `biosample` ...), the property aggregated on, and optional `terms` or `splits` for selection or binning of the property values.",
            "properties": {
                "concepts": {
                    "items": {
                        "$ref": "#/$defs/AggregationConcept"
                    },
                    "type": "array"
                },
                "description": {
                    "description": "Description of the aggregation performed for this term.",
                    "type": "string"
                },
                "distribution": {
                    "description": "A distribution contains a list of aggregation objects, where each describes the count of one (or more, intersected) values for the concept(s) aggregated on.",
                    "items": {
                        "$ref": "#/$defs/AggregationObject"
                    },
                    "type": "array"
                },
                "id": {
                    "description": "The id of the aggregation term being reported on.",
                    "type": "string"
                },
                "label": {
                    "description": "The label for the aggregation concept(s) being reported on.",
                    "examples": [
                        "Genders",
                        "Diseases by Sex at Birth",
                        "Follow-up Time After Diagnosis"
                    ],
                    "type": "string"
                },
                "scope": {
                    "description": "The scope (entity type) for which the results are reported.",
                    "examples": [
                        "individual",
                        "biosample",
                        "genomicVariation"
                    ],
                    "type": "string"
                }
            },
            "required": [
                "concepts",
                "distribution"
            ],
            "type": "object"
        },
        "ConceptValue": {
            "additionalItems": true,
            "description": "A value or bin ... for the concept property.",
            "properties": {
                "id": {
                    "description": "Identifier for the concept value. This can be e.g. a term id, a bin (e.g. '[P0D, P18M)'), or `undefined` for missing values.",
                    "examples": [
                        "NCIT:C4017",
                        "[P0D, P18M)",
                        "undefined"
                    ],
                    "type": "string"
                },
                "label": {
                    "description": "Human readable label for the concept value.",
                    "examples": [
                        "Breast Ductal Carcinoma",
                        "[P0D, P18M)"
                    ],
                    "type": "string"
                }
            },
            "required": [
                "id"
            ],
            "type": "object"
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Beacon aggregate results section.",
    "examples": {
        "$ref": "../examples-sections/beaconAggregationResults-examples.json#/examples"
    },
    "items": {
        "$ref": "#/$defs/AggregationResultsInstance"
    },
    "minItems": 0,
    "name": "Beacon Aggregation Results",
    "type": "array"
}