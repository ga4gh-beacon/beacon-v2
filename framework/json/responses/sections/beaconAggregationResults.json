{
    "$defs": {
        "AggregationResultsInstance": {
            "additionalItems": true,
            "description": "Summary data from results, with distributions for the aggregation terms given in the request.",
            "properties": {
                "count": {
                    "description": "Number of observations for this aggregation term.",
                    "minimum": 0,
                    "type": "integer"
                },
                "description": {
                    "description": "Description of this aggregation term",
                    "type": "string"
                },
                "entity": {
                    "description": "Entity for which the observations were reported. For the Beacon default model this is one of `individual`, `biosample`, `analysis`, `run`, or `genomicVariation`. The values here are not limited to the Beacon defaults to allow modified or alternative data models. Usually this parameter would be omitted, with the default being the  entity for which the Beacon is providing the current results.",
                    "type": "string"
                },
                "id": {
                    "$ref": "../../requests/summaryTerms.json#/$defs/AggregationTerm",
                    "description": "The id of this aggregation term"
                },
                "label": {
                    "description": "Label for this aggregation term",
                    "example": "Genders",
                    "type": "string"
                },
                "report": {
                    "$ref": "#/$defs/Report"
                }
            },
            "required": [
                "id",
                {
                    "oneOf": [
                        "count",
                        "report"
                    ]
                }
            ],
            "type": "object"
        },
        "Report": {
            "additionalItems": true,
            "description": "Report for this aggregation term representing a summary of results beyond a count of occurrences in the matched data. The format is left to the implementation but should not expose information about individual records.  ",
            "schema": {
                "description": "Optional reference to a schema for this report.",
                "type": "string"
            },
            "type": "object"
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Beacon aggregate results section.",
    "examples": [
        [
            {
                "count": 42,
                "entity": "biosample",
                "id": "NCIT:C3359",
                "label": "Rhabdomyosarcoma"
            },
            {
                "count": 44,
                "entity": "individual",
                "id": "ageAtDiagnosis:<=P17Y",
                "label": "age at diagnosis younger than 18 years"
            },
            {
                "count": 13,
                "entity": "individual",
                "id": "sex:=female",
                "label": "female sex at birth"
            },
            {
                "description": "sex per NCIT cancer code (custom format)",
                "id": "sexPerDisease",
                "label": "Sex distribution per cancer type",
                "report": [
                    {
                        "counts": {
                            "femaleAtBirth": 836,
                            "maleAtBirth": 3
                        },
                        "id": "NCIT:C4872",
                        "label": "Breast Carcinoma"
                    },
                    {
                        "counts": {
                            "femaleAtBirth": 36,
                            "maleAtBirth": 81
                        },
                        "id": "NCIT:C3513",
                        "label": "Esophageal Carcinoma"
                    }
                ]
            },
            {
                "description": "CNV frequencies per 1Mb genomic bin",
                "entity": "analysis",
                "id": "cnvstats",
                "label": "CNV frequencies",
                "report": {
                    "intervalfrequencies": [
                        {
                            "cytobands": "1p36.33",
                            "end": 400000,
                            "gainFrequency": 2.613,
                            "id": "1p:000000000-000400000",
                            "lossFrequency": 6.188,
                            "no": 1,
                            "referenceName": "chr1",
                            "start": 0
                        },
                        {
                            "cytobands": "1p36.33",
                            "end": 1400000,
                            "gainFrequency": 3.816,
                            "id": "1p:000400000-001400000",
                            "lossFrequency": 9.694,
                            "no": 2,
                            "referenceName": "chr1",
                            "start": 400000
                        }
                    ]
                },
                "schema": "https://www.example.org/cnvFrequenciesSchema"
            }
        ]
    ],
    "items": {
        "$ref": "#/$defs/AggregationResultsInstance"
    },
    "maturity": "draft",
    "minItems": 0,
    "name": "Beacon Aggregation Results",
    "type": "array"
}