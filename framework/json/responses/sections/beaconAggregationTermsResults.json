{
    "$defs": {
        "AggregationTermInResponse": {
            "description": "Information about the aggregation performed using this term.",
            "properties": {
                "concepts": {
                    "items": {
                        "$ref": "./beaconAggregationResults.json#/$defs/AggregationConcept"
                    },
                    "type": "array"
                },
                "description": {
                    "description": "A description of the summary concept, e.g. with details about the included properties and the operations performed during aggregation."
                },
                "id": {
                    "description": "The aggregation term id.",
                    "examples": [
                        "followupTime"
                    ],
                    "type": "string"
                },
                "label": {
                    "description": "A short label which e.g. can be used by clients to label diagrams or data tables.",
                    "examples": [
                        "Follow-up Time After Diagnosis"
                    ],
                    "type": "string"
                },
                "sorted": {
                    "description": "Indicates whether the resulting distribution results will be sorted in some way.",
                    "type": "boolean"
                }
            },
            "required": [
                "id"
            ],
            "type": "object"
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": true,
    "description": "Aggregation terms and concepts supported for this Beacon.",
    "properties": {
        "aggregationTerms": {
            "examples": [
                {
                    "concepts": [
                        {
                            "format": "iso8601duration",
                            "property": "individual.diseases.followup",
                            "splits": [
                                "P0D",
                                "P18M",
                                "P10Y",
                                "P60Y"
                            ],
                            "type": "string"
                        }
                    ],
                    "description": "Follow-up Time After Diagnosis",
                    "id": "followupTime",
                    "label": "Follow-up Time",
                    "sorted": true
                },
                {
                    "concepts": [
                        {
                            "property": "individual.diseases.diseaseCode.id"
                        },
                        {
                            "property": "individual.sex.id"
                        }
                    ],
                    "description": "Cancer type by sex in matched individuals",
                    "id": "diseaseBySex",
                    "label": "Sex distributions for Diseases in Individuals"
                }
            ],
            "items": {
                "$ref": "#/$defs/AggregationTermInResponse"
            },
            "type": "array"
        }
    },
    "type": "object"
}