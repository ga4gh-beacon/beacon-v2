{
    "$defs": {
        "AggregationTermInResponse": {
            "examples": [
                {
                    "description": "Aggregation by the karyotypic sex of the individuals. The karyotypic sex is determined by the chromosomal composition of the individual.",
                    "id": "karyotypicSex",
                    "label": "karyotypic sex",
                    "modelProperty": "individual.karyotypicSex"
                },
                {
                    "description": "Aggregation by the sex ploidy of the individuals.",
                    "id": "karyotypicSexPloidy",
                    "label": "sex ploidy",
                    "modelProperty": "individual.karyotypicSex",
                    "selectors": [
                        {
                            "label": "Diploid",
                            "value": "diploid"
                        },
                        {
                            "label": "Aneuploid",
                            "value": "aneuploid"
                        },
                        {
                            "label": "Polyploid",
                            "value": "polyploid"
                        }
                    ]
                },
                {
                    "description": "Aggregation by the age of onset of the individuals. The age of onset is calculated as the difference between the date of onset and the date of birth of the individual.",
                    "id": "ageOfOnset",
                    "label": "Age of Onset",
                    "modelProperty": "individual.diseases.ageofOnset",
                    "selectors": [
                        {
                            "label": "younger than 65 years",
                            "sortOrder": 1,
                            "splitValue": "P65Y"
                        },
                        {
                            "label": "65 years and older",
                            "sortOrder": 2,
                            "splitValue": "P150Y"
                        }
                    ]
                }
            ],
            "properties": {
                "description": {
                    "description": "Human readable description of the aggregation performed for this term.",
                    "type": "string"
                },
                "id": {
                    "description": "The id of the aggregation to be used in the request.",
                    "examples": [
                        "SexAtBirth",
                        "FollowupTime",
                        "HistologicalDiagnoses"
                    ],
                    "type": "string"
                },
                "label": {
                    "description": "The label for the aggregation concept being reported on.",
                    "examples": [
                        "Sex at Birth",
                        "Follow-up Time After Diagnosis",
                        "Diagnoses"
                    ],
                    "type": "string"
                },
                "modelProperty": {
                    "description": "The property in the data model on which the aggregation is actually performed. This is informative.",
                    "examples": [
                        "individual.sex",
                        "biosample.histologicalDiagnosis"
                    ],
                    "type": "string"
                },
                "selectors": {
                    "description": "Optional selectors for limiting or binning the aggregation on the `modelProperty`. If this parameter is present, it indicates that only the indicated values would be aggregated or that the results would be returned in bins (e.g. for continuous values).",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "../../requests/aggregationTerms.json#/$defs/ValueForAggregation"
                            },
                            {
                                "$ref": "../../requests/aggregationTerms.json#/$defs/RangeForAggregation"
                            },
                            {
                                "$ref": "../../requests/aggregationTerms.json#/$defs/SplitForAggregation"
                            }
                        ]
                    },
                    "minItems": 1,
                    "type": "array"
                }
            },
            "required": [
                "id",
                "modelProperty"
            ]
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "List of aggregation terms supported for this beacon. The aggregation terms detail the respective property which include the aggregation categories (e.g. all diagnoses or ageAtDiagnosis) applied when generating summaries.",
    "properties": {
        "aggregationTerms": {
            "items": {
                "$ref": "#/$defs/AggregationTermInResponse"
            },
            "type": "array"
        }
    },
    "type": "object"
}