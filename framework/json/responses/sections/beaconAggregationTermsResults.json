{
    "$defs": {
        "AggregationTermInResponse": {
            "description": "Information about the aggregation performed using this term.",
            "properties": {
                "description": {
                    "description": "A description of the aggregation term, e.g. for custom terms."
                },
                "id": {
                    "description": "The aggregation term id, either a valued filtering term or a custom value.",
                    "examples": [
                        "NCIT:C8936",
                        "ageAtDiagnosis:<=P17Y",
                        "cnvstats"
                    ],
                    "type": "string"
                },
                "label": {
                    "description": "A short label, e.g. \"preferred Label\" in the case of an ontology term.",
                    "examples": [
                        "B Lymphoblastic Leukemia/Lymphoma",
                        "Rhabdomyosarcoma"
                    ],
                    "type": "string"
                },
                "type": {
                    "enum": [
                        "count",
                        "report"
                    ],
                    "type": "string"
                }
            },
            "required": [
                "id"
            ],
            "type": "object"
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": true,
    "description": "Aggregation terms and concepts supported for this Beacon.",
    "examples": [
        [
            {
                "description": "count of matched Rhabdomyosarcoma samples",
                "entity": "biosample",
                "id": "NCIT:C3359",
                "label": "Rhabdomyosarcoma",
                "type": "count"
            },
            {
                "description": "count of individuals with an age at diagnosis younger than 18 years",
                "entity": "individual",
                "id": "ageAtDiagnosis:<=P17Y",
                "type": "count"
            },
            {
                "description": "CNV frequencies per 1Mb genomic bin.",
                "entity": "analysis",
                "id": "cnvstats",
                "type": "report"
            }
        ]
    ],
    "items": {
        "$ref": "#/$defs/AggregationTermInResponse"
    },
    "maturity": "draft",
    "type": "array"
}