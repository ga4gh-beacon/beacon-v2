{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Aggregation concepts supported for this Beacon.",
    "properties": {
        "aggregationTerms": {
            "items": {
                "$ref": "./beaconAggregationResults.json#/$defs/AggregationConcept"
            },
            "type": "array"
        },
        "examples": [
            {
                "description": "Follow-up Time After Diagnosis",
                "format": "iso8601duration",
                "id": "followupTime",
                "label": "Follow-up Time",
                "property": "individual.diseases.followup",
                "sorted": true,
                "splits": [
                    {
                        "label": "< 6 months",
                        "value": "P6M"
                    },
                    {
                        "label": "< 1 year",
                        "value": "P1Y"
                    },
                    {
                        "label": "< 18 months",
                        "value": "P18M"
                    },
                    {
                        "label": "< 3 years",
                        "value": "P3Y"
                    },
                    {
                        "label": "< 5 years",
                        "value": "P5Y"
                    },
                    {
                        "label": "< 10 years",
                        "value": "P10Y"
                    },
                    {
                        "label": "> 10 years",
                        "value": "P100Y"
                    }
                ],
                "type": "string"
            },
            {
                "description": "Disease type in matched individuals",
                "id": "disease",
                "label": "Diseases",
                "property": "individual.diseases.diseaseCode.id"
            }
        ]
    },
    "type": "object"
}