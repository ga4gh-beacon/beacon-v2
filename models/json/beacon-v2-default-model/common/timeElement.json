{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Definition of a wrapper for various time descriptors. This follows the\nPhenopackets structure https://github.com/phenopackets/phenopacket-schema/blob/v2/docs/time-element.rst",
    "oneOf": [
        {
            "age": {
                "$ref": "./age.json"
            }
        },
        {
            "ageRange": {
                "$ref": "./ageRange.json"
            }
        },
        {
            "gestationalAge": {
                "$ref": "./gestationalAge.json"
            }
        },
        {
            "timestamp": {
                "$ref": "./commonDefinitions.json#/$defs/Timestamp"
            }
        },
        {
            "interval": {
                "$ref": "./timeInterval.json"
            }
        },
        {
            "ontologyClass": {
                "$ref": "https://raw.githubusercontent.com/ga4gh-beacon/beacon-v2/main/framework/json/common/ontologyTerm.json",
                "description": "If using an ontology class the use of NCIT Age Group ontology term (NCIT:C20587) descendants is recommended."
            }
        }
    ],
    "title": "TimeElement",
    "type": [
        "object"
    ]
}