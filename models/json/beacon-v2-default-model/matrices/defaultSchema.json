{
    "$comment": "version: ga4gh-beacon-matrix-v2.1.2",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": true,
    "description": "A RNA-seq expression matrix available in the beacon",
    "properties": {
        "id": {
            "description": "Internal identifier of the matrix",
            "examples": [
                "1234567890"
            ],
            "type": "string"
        },
        "createDateTime": {
            "$ref": "../common/commonDefinitions.json#/$defs/Timestamp",
            "description": "The time the matrix was created (ISO 8601 format)",
            "examples": [
                "2017-01-17T20:33:40Z"
            ]
        },
        "description": {
            "description": "Description of the matrix",
            "examples": [
                "This matrix provides examples of the actual data in this Beacon instance."
            ],
            "type": "string"
        },
        "downloadUrl": {
            "description": "URL to download the matrix (RFC 3986 format).",
            "examples": [
                "https://example.org/matrices/matrix.csv"
            ],
            "type": "string"
        },
        "matrixId": {
            "description": "Unique identifier of the matrix",
            "examples": [
                "matrix-gene-expression-001"
            ],
            "type": "string"
        },
        "assayType": {
            "$ref": "https://raw.githubusercontent.com/ga4gh-beacon/beacon-v2/main/framework/json/common/ontologyTerm.json",
            "description": "Type of RNA-seq assay",
            "examples": [
                {
                    "id": "OBI:0002631",
                    "label": "single-cell RNA sequencing assay"
                },
                {
                    "id": "OBI:0003090",
                    "label": "bulk RNA-seq assay"
                }
            ]
        },
        "info": {
            "$ref": "../common/info.json"
        },
        "name": {
            "description": "Name of the matrix",
            "examples": [
                "Gene expression matrix"
            ],
            "type": "string"
        },
        "dimensions": {
            "type": "object",
            "properties": {
                "features": {
                    "type": "integer"
                },
                "biosamples": {
                    "type": "integer"
                }
            },
            "required": [
                "features",
                "biosamples"
            ]
        },
        "featureType": {
            "$ref": "https://raw.githubusercontent.com/ga4gh-beacon/beacon-v2/main/framework/json/common/ontologyTerm.json",
            "examples": [
                {
                    "id": "SO:0000704",
                    "label": "gene"
                }
            ],
            "description": "Ontology term that describes the type of genomic feature. Values from SO (Sequence ontology) are recommended."
        },
        "expressionValues": {
            "type": "object",
            "required": [
                "unit"
            ],
            "properties": {
                "unit": {
                    "enum": [
                        "raw",
                        "TPM",
                        "FPKM",
                        "RPKM",
                        "CPM",
                        "RPM"
                    ]
                },
                "scale": {
                    "enum": [
                        "linear",
                        "log2",
                        "log10"
                    ],
                    "description": "Whether values are linear or log-transformed. If not provided, it is assumed to be linear."
                }
            }
        },
        "annotation": {
            "type": "object",
            "properties": {
                "source": {
                    "examples": [
                        "Ensembl",
                        "Gencode",
                        "RefSeq"
                    ]
                },
                "version": {
                    "examples": [
                        "109",
                        "49"
                    ]
                },
                "file": {
                    "type": "string",
                    "description": "URL to the annotation file"
                },
                "md5Checksum": {
                    "type": "string",
                    "description": "MD5 checksum of the annotation file"
                }
            },
            "required": [
                "source",
                "version"
            ]
        },
        "assembly": {
            "description": "Assembly accession used to mapfeatureId the reads",
            "examples": {
                "accession": "GCA_000001405.29",
                "name": "GRCh38.p14"
            },
            "type": "object",
            "properties": {
                "accession": {
                    "description": "Assembly accession",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the assembly",
                    "type": "string"
                }
            },
            "required": [
                "accession",
                "name"
            ]
        }
    },
    "required": [
        "expressionValues",
        "matrixId"
    ],
    "type": "object"
}